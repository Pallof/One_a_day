@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject StatsStore Stats
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CurrentTeaserContext TeaserContext
@inject MetricsCounter Metrics
@inject AnswerGrader Grader
@inject IHttpContextAccessor HttpAccessor
@implements IDisposable

<div class="cv">
    <div class="oad-box cv-question" style="--q-lines: @QuestionLines.Of(Teaser.Question)">
        <div class="cv-question-head">
            <h2>Question:</h2>
            <DifficultyBadge Level="Teaser.Difficulty" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Note))
        {
            <p class="cv-note">@Note</p>
        }
        @* Can't be copied, so looking it up means typing it out (PRD 01). *@
        <p class="cv-question-text oad-no-copy">@Teaser.Question</p>

        @if (!string.IsNullOrWhiteSpace(Teaser.ImageFileName))
        {
            <img class="cv-image" src="@($"{ImageStore.RequestPath}/{Teaser.ImageFileName}")" alt="@Teaser.ImageDescription()" />
        }
    </div>

    @* Everything after the question. On a laptop it's the right-hand column, beside the
       question and its picture; on a phone it simply follows the question. *@
    <div class="cv-side">
    @* No hint, though the bank still holds one for most teasers (author's decision,
       2026-10-27; PRD 03). *@
    <div class="oad-box">
        <h2 id="cv-answer-label">Submission:</h2>
        @* @bind:after gives us a keystroke hook without fighting @bind:event for the
           oninput handler — it's what resets the quiet-period clock. The heading doubles as
           the box's label for screen readers. *@
        <textarea class="cv-input" aria-labelledby="cv-answer-label" rows="3" maxlength="@MaxSubmissionLength"
                  placeholder="Type your answer here..."
                  @bind="_submission" @bind:event="oninput" @bind:after="OnTyping"
                  disabled="@(_solved || _revealed)"></textarea>

        <div class="cv-submit-row">
            <button class="oad-btn-green" @onclick="CheckAnswer"
                    disabled="@(_solved || _revealed || _checking || string.IsNullOrWhiteSpace(_submission))">
                @(_checking ? "Checking…" : "Submit answer")
            </button>

            @* Solutions unlock the day after a challenge runs — never while it's live. *@
            @if (CanReveal && !_solved && !_revealed)
            {
                <button class="cv-reveal" @onclick="() => _revealed = true">Reveal solution</button>
            }
        </div>

        @if (_feedback is not null && !_revealed)
        {
            <p class="cv-feedback @(_solved ? "cv-correct" : "cv-incorrect")">@_feedback</p>
        }

        @* While a challenge is live its answer stays sealed — set expectations
           rather than leaving solvers hunting for a reveal button. *@
        @if (!CanReveal && !_solved && _attempts > 0)
        {
            <p class="cv-locked-note">No peeking today. The solution unlocks tomorrow.</p>
        }

        @if (_revealed || (_solved && !string.IsNullOrWhiteSpace(Teaser.Solution)))
        {
            <div class="cv-solution">
                @if (_revealed)
                {
                    <span><strong>Answer:</strong> @Teaser.Answer.Split(';')[0].Trim()</span>
                }
                @if (!string.IsNullOrWhiteSpace(Teaser.Solution))
                {
                    <div>@Teaser.Solution</div>
                }
            </div>
        }
    </div>

    @* Its own container, outside the submission box — the way to yesterday's
       answer, which is the one solution it's fair to publish. Daily page only. *@
    @if (IsDaily)
    {
        <div class="oad-box cv-yesterday-box">
            <a class="cv-yesterday" href="yesterday">
                <span>See yesterday's solution</span>
            </a>
        </div>
    }

    @* The countdown used to live only here, below the submission box and below the
       yesterday link — off-screen on most displays, with nothing to suggest it was
       there. It is announced in a dialog on solve instead, and this stays as the
       persistent copy for anyone who dismisses it and wants to look again. *@
    @if (_solved && IsDaily)
    {
        <div class="cv-next">
            <p class="cv-next-msg">Please come back soon for when the next challenge arrives!</p>
            <div class="cv-next-timer">@FormatCountdown(AppTime.UntilNextChallenge)</div>
            <p class="cv-next-sub">New challenge at midnight (Pacific Time)</p>
        </div>
    }

    @* Stats stay hidden until this visitor solves it, so they can't gauge
       the difficulty (or peek at the success rate) while still working on it. *@
    @if (_solved && _stats is not null && _stats.TotalSubmissions > 0)
    {
        <p class="cv-stats">
            @_stats.SuccessfulSubmissions.ToString("N0") out of @_stats.TotalSubmissions.ToString("N0")
            total @Wording.Plural(_stats.TotalSubmissions, "submission")
            @Wording.Plural(_stats.SuccessfulSubmissions, "was", "were") correct
        </p>
    }
    </div>
</div>

@* Always rendered on the daily page so the slide-out animates both ways; the
   component keeps itself off-screen until Visible. *@
@if (IsDaily)
{
    <TwentyFourNudge Visible="_showNudge" OnDismiss="DismissNudge" />
}

@* Announced on solve so the countdown can't be missed. Rendered outside .cv so the
   backdrop covers the whole viewport rather than being clipped by the reading column. *@
@if (_showSolved && IsDaily)
{
    <div class="cv-solved-backdrop" @onclick="DismissSolved"></div>

    <div class="cv-solved" role="dialog" aria-modal="true" aria-labelledby="cv-solved-title"
         tabindex="-1" @ref="_solvedDialog" @onkeydown="OnSolvedKeyDown">
        <button class="cv-solved-close" @onclick="DismissSolved" aria-label="Close">✕</button>

        @* The mascot, still stumped — by the visitor this time (PRD 09). The confetti is
           the celebration. *@
        <img class="cv-solved-mark" src="@Assets["img/stumpty.png"]" alt="" width="327" height="400" />
        <h2 id="cv-solved-title" class="cv-solved-title">Correct!</h2>
        <p class="cv-solved-sub">
            Solved in @_attempts @Wording.Plural(_attempts, "attempt").
        </p>

        @if (!string.IsNullOrWhiteSpace(Teaser.Solution))
        {
            <div class="cv-solved-solution">@Teaser.Solution</div>
        }

        <div class="cv-solved-next">
            <p class="cv-solved-next-label">Next challenge in</p>
            <div class="cv-next-timer">@FormatCountdown(AppTime.UntilNextChallenge)</div>
            <p class="cv-next-sub">Midnight, Pacific Time</p>
        </div>

        @if (_stats is not null && _stats.TotalSubmissions > 0)
        {
            <p class="cv-solved-stats">
                @_stats.SuccessfulSubmissions.ToString("N0") out of @_stats.TotalSubmissions.ToString("N0")
                total @Wording.Plural(_stats.TotalSubmissions, "submission")
                @Wording.Plural(_stats.SuccessfulSubmissions, "was", "were") correct
            </p>
        }

        <div class="cv-solved-actions">
            <a class="cv-solved-yesterday" href="yesterday">See yesterday's solution</a>
            <button class="oad-btn-plain" @onclick="DismissSolved">Close</button>
        </div>
    </div>
}

@code {
    private const int MaxSubmissionLength = 300;

    /// <summary>Wrong answers before we suggest a change of scene.</summary>
    private const int AttemptsBeforeNudge = 3;

    /// <summary>Quiet minutes before we assume they're stuck and staring.</summary>
    private const int IdleMinutesBeforeNudge = 5;

    /// <summary>Remembers a dismissal, so the nudge is a suggestion and not a nag.</summary>
    private const string NudgeDismissedKey = "oad-24-nudge-dismissed";

    [Parameter, EditorRequired] public BrainTeaser Teaser { get; set; } = default!;

    /// <summary>Italic note shown above the question (e.g. the home page fallback message).</summary>
    [Parameter] public string? Note { get; set; }

    /// <summary>Whether "Reveal solution" may appear after enough attempts. Keep false for today's challenge.</summary>
    [Parameter] public bool CanReveal { get; set; }

    /// <summary>Daily challenge only: after solving, show the countdown to the next challenge.</summary>
    [Parameter] public bool IsDaily { get; set; }

    private Guid _renderedTeaserId;

    /// <summary>The puzzle last counted as seen, so a new one (at midnight) counts too.</summary>
    private Guid _countedSeenId;

    private string _submission = string.Empty;
    private string? _feedback;
    private bool _solved;
    private bool _revealed;
    private int _attempts;

    /// <summary>While an answer is with the grader, which can wait up to five seconds on Jev (PRD 02).</summary>
    private bool _checking;
    private StatsSnapshot? _stats;
    private Timer? _countdownTimer;
    private DateOnly _solvedOn;

    /// <summary>Whether the solve dialog is up. Dismissed, it does not come back.</summary>
    private bool _showSolved;

    private ElementReference _solvedDialog;

    /// <summary>Set once, so focus moves to the dialog on the render that opens it.</summary>
    private bool _focusSolvedDialog;

    // ---- the Twenty Four nudge ------------------------------------------------
    private bool _showNudge;

    /// <summary>Once dismissed it never returns — persisted, so a reload doesn't nag.</summary>
    private bool _nudgeDismissed;

    private Timer? _idleTimer;

    protected override void OnParametersSet()
    {
        if (_renderedTeaserId == Teaser.Id)
        {
            return;
        }
        _renderedTeaserId = Teaser.Id;
        _submission = string.Empty;
        _feedback = null;
        _solved = false;
        _revealed = false;
        _attempts = 0;
        _showSolved = false;
        _stats = Stats.Get(Teaser.Id);
        StopCountdown();
        // Let "Report an issue" name the question being viewed.
        TeaserContext.Set(Teaser);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Move focus into the dialog the render it appears, so keyboard and screen
        // reader users land on it rather than being left behind on the submit button
        // with an announcement they can't reach.
        if (_focusSolvedDialog)
        {
            _focusSolvedDialog = false;
            try
            {
                await _solvedDialog.FocusAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit went away mid-celebration; nothing to focus.
            }
        }

        // Only ever runs in a live browser, never in the plain HTML render — which is what
        // keeps page-fetching bots out of the counts (PRD 16).
        if (IsDaily && _countedSeenId != Teaser.Id)
        {
            _countedSeenId = Teaser.Id;
            await Metrics.PuzzleSeenAsync(Teaser.Id);
        }

        if (!firstRender)
        {
            return;
        }
        // Respect an earlier dismissal before any trigger can fire. Read through
        // ReadOrDefaultAsync: a value this server can no longer decrypt — after the key ring is
        // rotated, restored or moved — would otherwise throw from here and kill the circuit.
        // An unreadable value just means the nudge shows once more, the harmless way to be wrong.
        _nudgeDismissed = await LocalStorage.ReadOrDefaultAsync<bool>(NudgeDismissedKey);

        // Start the quiet-period clock from the moment the page is usable.
        RestartIdleTimer();
    }

    private void DismissSolved()
    {
        _showSolved = false;
        // Only once the celebration is out of the way — two panels at once would be
        // shouting, and the dialog is the thing they actually earned.
        ShowNudge();
    }

    // ---- the Twenty Four nudge ------------------------------------------------

    /// <summary>
    /// Reveals the nudge, unless it has been dismissed. Safe to call from any trigger;
    /// whichever fires first wins and the rest become no-ops.
    /// </summary>
    private void ShowNudge()
    {
        if (_nudgeDismissed || !IsDaily)
        {
            return;
        }
        _showNudge = true;
        StopIdleTimer();   // it has served its purpose either way
    }

    private async Task DismissNudge()
    {
        _showNudge = false;
        _nudgeDismissed = true;
        StopIdleTimer();

        try
        {
            await LocalStorage.SetAsync(NudgeDismissedKey, true);
        }
        catch (Exception)
        {
            // Storage blocked or the circuit went away. Losing the preference only
            // means they may see it once more — not worth surfacing.
        }
    }

    /// <summary>
    /// (Re)starts the quiet-period countdown. Called on every keystroke and every
    /// submission, so the clock measures time since they last did anything — a person
    /// typing steadily is not stuck.
    /// </summary>
    private void RestartIdleTimer()
    {
        if (_nudgeDismissed || _showNudge || !IsDaily)
        {
            return;
        }

        StopIdleTimer();
        _idleTimer = new Timer(
            _ => InvokeAsync(() => { ShowNudge(); StateHasChanged(); }),
            null,
            TimeSpan.FromMinutes(IdleMinutesBeforeNudge),
            Timeout.InfiniteTimeSpan);   // one shot, not a repeat
    }

    private void StopIdleTimer()
    {
        _idleTimer?.Dispose();
        _idleTimer = null;
    }

    /// <summary>Escape closes the dialog, as every dialog should.</summary>
    private void OnSolvedKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showSolved = false;
        }
    }

    private async Task CheckAnswer()
    {
        // Once solved or revealed, the box and the button are disabled — but only in the
        // browser. A client driving the live connection can still call this, and every call
        // would count as another correct answer in everyone's statistics. Re-solving still
        // works the intended way: come back to the page and start fresh.
        // _checking too: an answer waiting on Jev must not be counted twice by a second click.
        if (_solved || _revealed || _checking || string.IsNullOrWhiteSpace(_submission))
        {
            return;
        }

        // The maxlength attribute handles honest browsers; this backstops
        // anything that bypasses it (e.g. crafted SignalR messages).
        if (_submission.Length > MaxSubmissionLength)
        {
            _submission = _submission[..MaxSubmissionLength];
        }

        _attempts++;
        bool correct;
        _checking = true;
        try
        {
            // What was sent, even if they carry on typing while it's checked. The address is
            // for this visitor's share of today's questions to Jev.
            correct = await Grader.IsCorrectAsync(Teaser, _submission,
                VisitorAddress.Key(HttpAccessor.HttpContext?.Connection.RemoteIpAddress));
        }
        finally
        {
            _checking = false;
        }

        if (correct)
        {
            _solved = true;
            _feedback = $"Correct! Solved in {_attempts} {Wording.Plural(_attempts, "attempt")}.";
            if (IsDaily)
            {
                StartCountdown();
                _showSolved = true;
                _focusSolvedDialog = true;
            }
        }
        else
        {
            _feedback = CanReveal
                ? "Not quite. Try again, or reveal the solution."
                : "Not quite. Stretch that brain and try again!";

            // Struggling. Offer a change of scene rather than letting them grind —
            // and only after several genuine tries, so it never reads as "give up".
            if (_attempts >= AttemptsBeforeNudge)
            {
                ShowNudge();
            }
            else
            {
                RestartIdleTimer();   // still going; reset the quiet clock
            }
        }

        Stats.RecordSubmission(Teaser.Id, _solved);
        _stats = Stats.Get(Teaser.Id);
        if (IsDaily)
        {
            await Metrics.AnswerAsync(Teaser.Id, correct: _solved);
        }

        if (_solved)
        {
            await JS.InvokeVoidAsync("oadCelebrate");
        }
    }

    /// <summary>Any keystroke counts as activity — someone typing is not stuck.</summary>
    private void OnTyping() => RestartIdleTimer();

    private void StartCountdown()
    {
        _solvedOn = AppTime.Today;
        _countdownTimer ??= new Timer(_ => InvokeAsync(OnCountdownTick), null,
            TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnCountdownTick()
    {
        // Midnight Pacific passed: the next challenge is live, load it.
        if (AppTime.Today != _solvedOn)
        {
            StopCountdown();
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
            return;
        }
        StateHasChanged();
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private static string FormatCountdown(TimeSpan remaining) =>
        $"{(int)remaining.TotalHours:D2}:{remaining.Minutes:D2}:{remaining.Seconds:D2}";

    public void Dispose()
    {
        StopCountdown();
        // Without this the idle timer outlives the component and fires into a dead
        // circuit five minutes after someone navigates away.
        StopIdleTimer();
        // Navigating away: stop attributing issue reports to this question.
        TeaserContext.Clear(_renderedTeaserId);
    }
}
