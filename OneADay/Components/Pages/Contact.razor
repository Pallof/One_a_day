@page "/contact"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject SuggestionStore Suggestions
@inject EmailNotifier Notifier
@inject ProtectedLocalStorage LocalStorage
@inject IHttpContextAccessor HttpAccessor
@inject IpHasher Hasher

<PageTitle>One a Day — Contact us</PageTitle>

<div class="oad-static">
    <div class="oad-banner">Contact us</div>

    <div class="oad-box">
        <p class="oad-contact-intro">
            Got a great brain teaser you'd like to see featured? Send it in below —
            if it stumps us, it might become a future Challenge of the day!
        </p>

        @if (_limitReached)
        {
            <div class="oad-contact-thanks">
                <p>🧠 You've already sent us a suggestion today — one per day keeps the inbox fresh. Come back tomorrow with your next stumper!</p>
            </div>
        }
        else if (_submitted)
        {
            <div class="oad-contact-thanks">
                <p>🎉 Thanks for your suggestion — we'll take a look! You can send another one tomorrow.</p>
            </div>
        }
        else
        {
            <div class="oad-contact-field">
                <label for="difficulty">Question difficulty</label>
                <select id="difficulty" @bind="_difficulty">
                    <option>Easy</option>
                    <option>Medium</option>
                    <option>Hard</option>
                </select>
            </div>

            <div class="oad-contact-field">
                <label for="teaser">The brain teaser *</label>
                <textarea id="teaser" rows="3" maxlength="600"
                          placeholder="Your riddle or puzzle..."
                          @bind="_question" @bind:event="oninput"></textarea>
            </div>

            <div class="oad-contact-field">
                <label for="solution">Solution + hint *</label>
                <textarea id="solution" rows="3" maxlength="600"
                          placeholder="The answer, and a hint we can offer to solvers who get stuck"
                          @bind="_solutionAndHint" @bind:event="oninput"></textarea>
            </div>

            @* Decoy field. Hidden from sight, from the tab order, and from screen
               readers, so no person ever fills it in — but a script filling every
               input will. Do not add a <label>, and do not remove aria-hidden. *@
            <input class="oad-hp" id="website" name="website" type="text"
                   tabindex="-1" autocomplete="off" aria-hidden="true"
                   @bind="_honeypot" @bind:event="oninput" />

            <button class="oad-btn-green" @onclick="Submit"
                    disabled="@(string.IsNullOrWhiteSpace(_question) || string.IsNullOrWhiteSpace(_solutionAndHint))">
                Submit suggestion
            </button>
            <p class="oad-contact-limit-note">One suggestion per day.</p>
        }
    </div>
</div>

@code {
    private const string VisitorKey = "oad-visitor-id";

    private string _difficulty = "Medium";
    private string _question = string.Empty;
    private string _solutionAndHint = string.Empty;
    private bool _submitted;
    private bool _limitReached;
    private Guid _visitorId;

    /// <summary>Decoy field — see the markup. Anything here means a script filled it.</summary>
    private string _honeypot = string.Empty;

    /// <summary>
    /// When the form became interactive. Held server-side in the circuit, so the
    /// client can neither read nor backdate it.
    /// </summary>
    private DateTime _formShownAt;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        _formShownAt = DateTime.UtcNow;

        // See ProtectedStorageExtensions: a value this server can no longer decrypt must not
        // throw from here, or the visitor loses the page instead of the stored id.
        var stored = await LocalStorage.ReadOrDefaultAsync<Guid>(VisitorKey);
        if (stored != Guid.Empty)
        {
            _visitorId = stored;
        }
        else
        {
            _visitorId = Guid.NewGuid();
            await LocalStorage.SetAsync(VisitorKey, _visitorId);
        }

        if (Suggestions.HasReachedDailyLimit(_visitorId, GetIpHash(), AppTime.Today))
        {
            _limitReached = true;
            StateHasChanged();
        }
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_question) || string.IsNullOrWhiteSpace(_solutionAndHint))
        {
            return;
        }
        // Looks scripted? Show the normal thank-you and quietly drop it. Telling a bot
        // it was caught only teaches whoever wrote it which check to work around.
        if (SubmissionGuard.LooksAutomated(_honeypot, DateTime.UtcNow - _formShownAt))
        {
            Suggestions.RecordBlocked();
            _submitted = true;
            return;
        }

        if (_visitorId == Guid.Empty)
        {
            _visitorId = Guid.NewGuid();
        }

        var suggestion = new TeaserSuggestion
        {
            SubmittedAt = AppTime.NowPacific,
            Difficulty = NormalisedDifficulty(),
            Question = _question.Trim(),
            SolutionAndHint = _solutionAndHint.Trim(),
        };

        var accepted = Suggestions.TryAdd(suggestion, _visitorId, GetIpHash(), AppTime.Today);

        if (accepted)
        {
            _submitted = true;

            // Saved first, notified second. Enqueue never blocks and never throws, so
            // a mail problem can't cost this visitor their suggestion — it is already
            // on disk and visible in admin either way.
            Notifier.Enqueue(
                $"One a Day — new teaser suggestion ({suggestion.Difficulty})",
                $"""
                 A visitor suggested a teaser.

                 Difficulty : {suggestion.Difficulty}
                 Submitted  : {suggestion.SubmittedAt:dddd d MMMM yyyy, h:mm tt} Pacific

                 THE TEASER
                 {suggestion.Question}

                 SOLUTION + HINT
                 {suggestion.SolutionAndHint}

                 Review it in admin to promote it into the teaser form or delete it.
                 """);
        }
        else
        {
            _limitReached = true;
        }
    }

    /// <summary>
    /// The chosen difficulty, forced back to a known value.
    /// </summary>
    /// <remarks>
    /// A <c>&lt;select&gt;</c> constrains what a <i>browser</i> sends, not what the server
    /// receives: Blazor performs no server-side check that a bound value was one of the
    /// rendered options, so a client driving the circuit directly can put arbitrary text
    /// here. Unchecked it would be persisted raw to suggestions.json and interpolated
    /// into a mail subject — a 40,000-character subject that Gmail rejects would burn
    /// three retry attempts and a slot from the daily send budget.
    ///
    /// Admin already normalises this field the same way when promoting a suggestion
    /// (<c>Enum.TryParse ... : Difficulty.Medium</c>); doing it at the point of entry
    /// means the bad value is never stored in the first place.
    /// </remarks>
    private string NormalisedDifficulty() =>
        Enum.TryParse<Difficulty>(_difficulty, ignoreCase: true, out var parsed)
            ? parsed.ToString()
            : nameof(Difficulty.Medium);

    /// <summary>
    /// Keyed hash of the client IP — never stored raw, and never a plain hash either: see
    /// <see cref="IpHasher"/> for why an unkeyed one is the address wearing a hat. Null when
    /// there is no address to hash, which the store reads as "no IP layer for this one".
    /// </summary>
    private string? GetIpHash() =>
        Hasher.Hash(HttpAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString());
}
