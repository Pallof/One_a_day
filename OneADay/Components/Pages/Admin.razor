@page "/admin"
@* This page exists only on the author's machine. On the live site the server answers
   /admin with 404 and the router refuses to build it, so none of what follows ever runs
   there — see AdminAccess and PRD 10. Changes to live data made here (the queues, the
   rotation reset) therefore only touch the local copy. *@
@inject TeaserStore Store
@inject StatsStore Stats
@inject SuggestionStore Suggestions
@inject ImageStore Images
@inject IssueStore Issues
@inject RotationStore Rotation
@inject JudgedAnswerStore Judged
@inject AgreedVerdictStore Agreed
@inject Microsoft.Extensions.Options.IOptions<JevOptions> JevSettings

<PageTitle>Stumpty · Add a teaser</PageTitle>

<div class="oad-admin">
    <div class="oad-banner">@(_editingId is null ? "Add a brain teaser" : "Edit brain teaser")</div>

    <div class="oad-box">
        <div class="oad-field">
            <label for="date">Show on date</label>
            <InputDate id="date" @bind-Value="_form.Date" />
            @if (_dateWarning is not null)
            {
                <span class="oad-warning">@_dateWarning</span>
            }
        </div>

        <div class="oad-field">
            <label for="difficulty">Difficulty</label>
            <div class="oad-difficulty-row">
                <InputSelect id="difficulty" @bind-Value="_form.Difficulty">
                    <option value="@Difficulty.Easy">Easy</option>
                    <option value="@Difficulty.Medium">Medium</option>
                    <option value="@Difficulty.Hard">Hard</option>
                </InputSelect>
                <DifficultyBadge Level="_form.Difficulty" />
            </div>
        </div>

        <div class="oad-field">
            <label for="question">Question *</label>
            <textarea id="question" rows="4" placeholder="The brain teaser itself..."
                      @bind="_form.Question"></textarea>
        </div>

        <div class="oad-field">
            <label for="answer">Answer *</label>
            <input id="answer" type="text" placeholder="Accepted answer. Separate alternatives with ; (e.g. 9; nine)"
                   @bind="_form.Answer" />
        </div>

        <div class="oad-field">
            <label for="not-accepted">Ruled wrong (optional)</label>
            <input id="not-accepted" type="text" placeholder="Answers you've decided are wrong, separated with ;. Jev is never asked about them."
                   @bind="_form.NotAccepted" />
        </div>

        <div class="oad-field">
            <label for="tags">Tags (optional)</label>
            <input id="tags" type="text" placeholder="Comma-separated labels, e.g. logic, wordplay, math" @bind="_tagsText" @bind:event="oninput" />
            @if (ParsedTags.Count > 0)
            {
                <div class="oad-tag-preview">
                    @foreach (var tag in ParsedTags)
                    {
                        <span class="oad-tag-chip">@tag</span>
                    }
                </div>
            }
        </div>

        <div class="oad-field">
            <label for="image">Support image (optional)</label>
            <InputFile id="image" OnChange="OnImageSelected" accept="image/png,image/jpeg,image/gif,image/webp" />
            @if (_imageError is not null)
            {
                <span class="oad-warning">@_imageError</span>
            }
            @if (_imageNote is not null)
            {
                <span class="oad-warning">@_imageNote</span>
            }
            @if (!string.IsNullOrWhiteSpace(_form.ImageFileName))
            {
                <div class="oad-image-preview">
                    <img src="@($"{ImageStore.RequestPath}/{_form.ImageFileName}")" alt="Selected support image" />
                    <button type="button" class="oad-btn-danger" @onclick="RemoveImage">Remove image</button>
                </div>
            }
        </div>

        @* Required with a picture (PRD 05): a screen reader reads it out, and an email app that
           holds pictures back shows it instead. *@
        @if (!string.IsNullOrWhiteSpace(_form.ImageFileName))
        {
            <div class="oad-field">
                <label for="image-alt">Describe the picture *</label>
                <textarea id="image-alt" rows="2" maxlength="@MaxImageAltLength"
                          placeholder="What it shows, for anyone who can't see it. Include every number or label a solver needs."
                          @bind="_form.ImageAlt" @bind:event="oninput"></textarea>
            </div>
        }

        <div class="oad-field">
            <label for="hint">Hint (optional)</label>
            <input id="hint" type="text" placeholder="Kept with the teaser. The site doesn't show hints (PRD 03)." @bind="_form.Hint" />
        </div>

        <div class="oad-field">
            <label for="solution">Solution / explanation (optional)</label>
            <textarea id="solution" rows="3" placeholder="Explanation revealed once solved or on past questions"
                      @bind="_form.Solution"></textarea>
        </div>

        <div class="oad-field">
            <label for="suggested-by">Suggested by (optional)</label>
            <input id="suggested-by" type="text" maxlength="@TeaserSuggestion.MaxNameLength"
                   placeholder="The visitor to credit. Filled in from their suggestion." @bind="_form.SuggestedBy" />
        </div>

        <div class="oad-admin-actions">
            <button class="oad-btn-green" @onclick="SaveAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_form.Question) || string.IsNullOrWhiteSpace(_form.Answer) || PictureNeedsDescription)">
                @(_editingId is null ? "Add teaser" : "Save changes")
            </button>
            @if (_editingId is not null)
            {
                <button class="oad-btn-plain" @onclick="() => ResetForm()">Cancel edit</button>
            }
        </div>

        @if (_savedMessage is not null)
        {
            <p class="oad-saved">@_savedMessage</p>
        }
    </div>

    @* Everything below the form starts collapsed, to cut the clutter; the arrow opens a
       section. Native <details>: the browser keeps each open/closed state, and Blazor
       leaves it alone on re-render because the markup never sets `open` either way. The
       counts sit in the summary so a collapsed section still says when something needs
       attention. *@
    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Scheduled &amp; past teasers</span>
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            @if (_all.Count == 0)
            {
                <p>No teasers yet. Add your first one above.</p>
            }
            else
            {
                @* Wide table scrolls inside its own box — otherwise it drags the whole
                   page sideways and breaks the centred column. *@
                <div class="oad-admin-table-scroll">
                <table class="oad-admin-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Difficulty</th>
                            <th>Question</th>
                            <th>Tags</th>
                            <th>Answer</th>
                            <th>Stats</th>
                            <th>Shown</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teaser in _all)
                        {
                            <tr class="@(teaser.Date == _today ? "oad-row-today" : teaser.Date > _today ? "oad-row-future" : "")">
                                <td class="oad-cell-date">@teaser.Date.ToString("ddd d MMM yyyy")</td>
                                <td><DifficultyBadge Level="teaser.Difficulty" /></td>
                                <td>@Truncate(teaser.Question, 80)</td>
                                <td class="oad-cell-tags">
                                    @if (teaser.Tags.Count > 0)
                                    {
                                        @foreach (var tag in teaser.Tags)
                                        {
                                            <span class="oad-tag-chip">@tag</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="oad-cell-muted">none</span>
                                    }
                                </td>
                                <td>@Truncate(teaser.Answer, 30)</td>
                                <td class="oad-cell-stats">@StatsSummary(teaser.Id)</td>
                                <td class="oad-cell-stats">@ShowSummary(teaser.Id)</td>
                                <td class="oad-cell-actions">
                                    <button class="oad-btn-plain" @onclick="() => Edit(teaser)">Edit</button>
                                    <button class="oad-btn-danger" @onclick="() => Delete(teaser.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </details>

    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Visitor suggestions</span>
            @if (_suggestions.Count > 0)
            {
                <span class="oad-section-count">@_suggestions.Count</span>
            }
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            @if (_blockedCount > 0)
            {
                <p class="oad-suggestion-blocked">
                    <strong>@_blockedCount</strong> @Wording.Plural(_blockedCount, "submission")
                    dropped as automated (honeypot or faster than
                    @SubmissionGuard.MinComposeSeconds seconds). These are rejected silently
                    and never appear below.
                </p>
            }

            @if (_suggestions.Count == 0)
            {
                <p>No suggestions yet. They'll appear here when visitors submit one on the Suggest a teaser page.</p>
            }
            else
            {
                @foreach (var suggestion in _suggestions)
                {
                    <div class="oad-suggestion" @key="suggestion.Id">
                        <div class="oad-suggestion-meta">
                            <span class="oad-suggestion-difficulty">@suggestion.Difficulty</span>
                            <span>@suggestion.SubmittedAt.ToString("d MMM yyyy, h:mm tt") PT</span>
                            <span class="oad-suggestion-author">@(string.IsNullOrEmpty(suggestion.AuthorName) ? "No name given" : $"From {suggestion.AuthorName}")</span>
                        </div>
                        <p class="oad-suggestion-q">@suggestion.Question</p>
                        <p class="oad-suggestion-s"><strong>Solution:</strong> @suggestion.SolutionAndHint</p>
                        <div class="oad-suggestion-actions">
                            <button class="oad-btn-plain" @onclick="() => UseSuggestion(suggestion)">Use in form above</button>
                            <button class="oad-btn-danger" @onclick="() => DeleteSuggestion(suggestion.Id)">Delete</button>
                        </div>
                    </div>
                }
            }
        </div>
    </details>

    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Recycling box</span>
            <span class="oad-section-count">@_queueAhead scheduled ahead</span>
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            <p class="oad-rotation-lead">
                New teasers always run on their own date. Once the queue is empty, past
                teasers are drawn from a box without replacement, so none repeats until the
                box refills. Teasers shown less often are weighted to come up sooner.
            </p>
            <p class="oad-rotation-state">
                <strong>@_boxRemaining</strong> of <strong>@_bankSize</strong> still in the box
                &middot; refills at @TeaserRotation.RefillThreshold(_bankSize) left
                &middot; <strong>@_queueAhead</strong> new @Wording.Plural(_queueAhead, "teaser") scheduled ahead
            </p>

            @if (_recentRuns.Count > 0)
            {
                <div class="oad-admin-table-scroll">
                <table class="oad-admin-table oad-rotation-table">
                    <thead><tr><th>Day</th><th>Ran</th><th>Source</th></tr></thead>
                    <tbody>
                        @foreach (var run in _recentRuns)
                        {
                            <tr>
                                <td class="oad-cell-date">@run.Date.ToString("ddd d MMM")</td>
                                <td>@Truncate(Store.GetById(run.TeaserId)?.Question ?? "(deleted)", 60)</td>
                                <td>@(run.Recycled ? "recycled" : "new")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }

            <div class="oad-rotation-actions">
                <button class="oad-btn-plain" @onclick="ResetBox">Reset the box now</button>
            </div>
        </div>
    </details>

    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Site metrics</span>
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            <MetricsPanel />
        </div>
    </details>

    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Reported issues</span>
            @if (Issues.OpenCount > 0)
            {
                <span class="oad-section-count">@Issues.OpenCount open</span>
            }
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            @if (_issuesBlockedCount > 0)
            {
                <p class="oad-suggestion-blocked">
                    <strong>@_issuesBlockedCount</strong> @Wording.Plural(_issuesBlockedCount, "report")
                    dropped as automated (honeypot or faster than
                    @SubmissionGuard.MinComposeSeconds seconds). Reports are never rate
                    limited; this only screens out scripts.
                </p>
            }

            @if (_issues.Count == 0)
            {
                <p>No issues reported. They'll appear here when a visitor uses the "Report an issue" button.</p>
            }
            else
            {
                @foreach (var issue in _issues)
                {
                    <div class="oad-issue @(IssueStatusInfo.IsOpen(issue.Status) ? "" : "oad-issue-closed")" @key="issue.Id">
                        <div class="oad-issue-meta">
                            <span class="oad-issue-status oad-status-@IssueStatusInfo.CssName(issue.Status)">
                                @IssueStatusInfo.Label(issue.Status)
                            </span>
                            <span class="oad-issue-category">@issue.Category</span>
                            <span>@issue.SubmittedAt.ToString("d MMM yyyy, h:mm tt") PT</span>
                            @if (issue.StatusUpdatedAt is not null)
                            {
                                <span class="oad-issue-updated">updated @issue.StatusUpdatedAt.Value.ToString("d MMM")</span>
                            }
                        </div>

                        <p class="oad-issue-details">@issue.Details</p>

                        <p class="oad-issue-context">
                            @if (issue.TeaserQuestion is not null)
                            {
                                <span>Question: <em>@Truncate(issue.TeaserQuestion, 90)</em></span>
                                @if (issue.TeaserId is not null && _all.Any(t => t.Id == issue.TeaserId))
                                {
                                    <button class="oad-btn-plain oad-issue-jump"
                                            @onclick="() => EditById(issue.TeaserId.Value)">Edit that teaser</button>
                                }
                            }
                            else if (issue.TwentyFourHand is { } hand)
                            {
                                <span>Twenty Four hand: <strong>@string.Join(" ", hand)</strong></span>
                            }
                            else
                            {
                                <span>Filed from @(issue.PageUrl ?? "unknown page")</span>
                            }
                        </p>

                        <div class="oad-issue-actions">
                            <label class="oad-issue-statuslabel" for="status-@issue.Id">Status:</label>
                            @* Single source of truth for the selection: `selected` on the
                               options. Adding `value` on the select as well can make the
                               browser and Blazor disagree and fire a spurious change. *@
                            <select id="status-@issue.Id" class="oad-issue-select"
                                    @onchange="e => SetIssueStatus(issue.Id, e.Value?.ToString())">
                                @foreach (var status in IssueStatusInfo.All)
                                {
                                    <option value="@status" selected="@(status == issue.Status)">
                                        @IssueStatusInfo.Label(status)
                                    </option>
                                }
                            </select>
                            <button class="oad-btn-danger" @onclick="() => DeleteIssue(issue.Id)">Delete</button>
                        </div>
                    </div>
                }
            }
        </div>
    </details>

    @* Jev's verdicts still waiting for the author's (PRD 02). Ruling on one writes it into the
       question's answers in teasers.json, so it drops off this list and the checker decides it
       from then on. *@
    <details class="oad-admin-section">
        <summary class="oad-banner">
            <span>Answers Jev judged</span>
            @if (_toReview.Count > 0)
            {
                <span class="oad-section-count">@_toReview.Count new from Jev</span>
            }
            <span class="oad-chevron" aria-hidden="true"></span>
        </summary>

        <div class="oad-box">
            <p class="oad-rotation-lead">
                Answers the checker turned down and Jev then judged, newest first. This is this Mac's
                copy: stop the site and run <code>sh deploy/pull-live-data.sh</code> for the live one.
                Agreeing with Jev clears a row here and changes nothing else. Ruling an answer wrong
                goes into the question, so publish teasers.json afterwards. To pass an answer Jev
                turned down, add it in your own words with Edit.
            </p>

            @if (_toReview.Count == 0)
            {
                <p>Nothing new from Jev.</p>
            }
            else
            {
                @foreach (var (judged, teaser) in _toReview)
                {
                    var passes = JevSettings.Value.Passes(judged.Chance);
                    <div class="oad-issue jv-judged" @key="(judged.TeaserId, judged.Submission)">
                        <div class="oad-issue-meta">
                            <span class="oad-issue-status jv-verdict @(passes ? "oad-status-solved" : "oad-status-wontsolve")">
                                @(passes ? "Counts as right" : "Counts as wrong")
                            </span>
                            <span>Jev: @judged.Chance.ToString("0%", System.Globalization.CultureInfo.InvariantCulture) same answer</span>
                            <span>@judged.JudgedAt.ToString("d MMM yyyy, h:mm tt") PT</span>
                        </div>
                        <p class="oad-issue-details jv-typed">@judged.Submission</p>
                        <p class="oad-issue-context"><span>Question: <em>@Truncate(teaser.Question, 90)</em></span></p>
                        <div class="oad-issue-actions">
                            <button class="oad-btn-plain jv-agree" @onclick="() => AgreeWithJev(judged)">Agree with Jev</button>
                            @* Only where it counts as right: an answer already wrong needs no ruling. *@
                            @if (passes)
                            {
                                <button class="oad-btn-danger jv-rule-out" @onclick="() => RuleWrong(judged)">Rule it wrong</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </details>
</div>

@code {
    private BrainTeaser _form = new();
    private Guid? _editingId;
    private string? _savedMessage;
    private string? _dateWarning;
    private string _tagsText = string.Empty;
    private string? _imageError;
    private string? _imageNote;           // a picture big enough to load slowly on a phone
    private string? _originalImageName;   // image the teaser had when Edit was opened

    private const int MaxImageAltLength = 400;

    /// <summary>Above this, a picture still saves, with a note: it loads slowly on a phone.</summary>
    private const long SuggestedMaxImageBytes = 200 * 1024;

    private bool PictureNeedsDescription =>
        !string.IsNullOrWhiteSpace(_form.ImageFileName) && string.IsNullOrWhiteSpace(_form.ImageAlt);
    private DateOnly _today;
    private IReadOnlyList<BrainTeaser> _all = [];
    private IReadOnlyList<TeaserSuggestion> _suggestions = [];
    private int _blockedCount;
    private IReadOnlyList<IssueReport> _issues = [];
    private int _issuesBlockedCount;
    private IReadOnlyList<DailyRun> _recentRuns = [];
    private IReadOnlyDictionary<Guid, int> _showCounts = new Dictionary<Guid, int>();

    /// <summary>
    /// Jev's verdicts still in force that the author hasn't agreed with or ruled on, each with
    /// its question. One made before the question was last edited no longer counts, so it isn't
    /// listed.
    /// </summary>
    private IReadOnlyList<(JudgedAnswer Judged, BrainTeaser Teaser)> _toReview = [];

    /// <summary>Times shown, and the draw weight that follows from it.</summary>
    private string ShowSummary(Guid teaserId)
    {
        var shows = _showCounts.GetValueOrDefault(teaserId);
        return $"{shows}x (weight {TeaserRotation.WeightFor(shows):0.00})";
    }
    private int _boxRemaining;
    private int _bankSize;
    private int _queueAhead;

    private void ResetBox()
    {
        Rotation.ResetBox();
        Refresh();
    }

    private List<string> ParsedTags => _tagsText
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override void OnInitialized()
    {
        _today = AppTime.Today;
        ResetForm();
        Refresh();
    }

    private void Refresh()
    {
        _all = Store.GetAll();
        _suggestions = Suggestions.GetAll();
        _blockedCount = Suggestions.BlockedCount;
        _issues = Issues.GetAll();
        _issuesBlockedCount = Issues.BlockedCount;

        var snapshot = Rotation.Snapshot();
        _boxRemaining = snapshot.Remaining;
        _recentRuns = snapshot.Recent;
        _showCounts = snapshot.ShowCounts;
        _bankSize = Store.ReleasedOn(_today).Count;
        _queueAhead = _all.Count(t => t.Date > _today);

        _toReview = Judged.GetAll()
            .Select(j => (Judged: j, Teaser: _all.FirstOrDefault(t => t.Id == j.TeaserId)))
            .Where(r => r.Teaser is not null && r.Judged.StillStandsFor(r.Teaser) && !Agreed.Contains(r.Judged) &&
                        !r.Teaser.AcceptsAnswer(r.Judged.Submission) && !r.Teaser.RulesOut(r.Judged.Submission))
            .Select(r => (r.Judged, r.Teaser!))
            .ToList();
    }

    /// <summary>
    /// Clears the row, remembered on this Mac only. What a visitor typed never goes into the
    /// accepted answers: the author adds those in their own words (PRD 02).
    /// </summary>
    private void AgreeWithJev(JudgedAnswer judged)
    {
        Agreed.Add(judged);
        Refresh();
    }

    /// <summary>Rules the answer wrong, which beats Jev's verdict on it, whatever that was.</summary>
    private void RuleWrong(JudgedAnswer judged) =>
        Rule(judged, t => t.NotAccepted = string.IsNullOrWhiteSpace(t.NotAccepted)
            ? AsOneAnswer(judged.Submission)
            : $"{t.NotAccepted}; {AsOneAnswer(judged.Submission)}");

    private void Rule(JudgedAnswer judged, Action<BrainTeaser> ruling)
    {
        if (Store.GetById(judged.TeaserId) is not { } teaser)
        {
            return;
        }
        ruling(teaser);
        Store.Save(teaser);
        // The same question open in the form would otherwise save its older answers back over this.
        if (_editingId == teaser.Id)
        {
            ruling(_form);
        }
        Refresh();
    }

    /// <summary>
    /// What was typed, as one answer. A ';' in it would split it into several, and one pair of
    /// brackets would rule out each side on its own too: "second place (or third)" would rule
    /// out a bare "second place" (PR 74 review). Matching ignores the punctuation either way.
    /// </summary>
    private static string AsOneAnswer(string typed) =>
        typed.Replace(';', ',').Replace('(', ' ').Replace(')', ' ').Trim();

    private void ResetForm(bool discardStaged = true)
    {
        if (discardStaged)
        {
            DiscardStagedImage();
        }
        _editingId = null;
        _originalImageName = null;
        _tagsText = string.Empty;
        _imageError = null;
        _imageNote = null;
        // Default to the first upcoming day that doesn't have a teaser yet.
        var date = _today;
        while (Store.GetForDate(date) is not null)
        {
            date = date.AddDays(1);
        }
        _form = new BrainTeaser { Date = date };
        _dateWarning = null;
    }

    private void Edit(BrainTeaser teaser)
    {
        DiscardStagedImage();   // drop an un-saved upload from any in-progress form
        _editingId = teaser.Id;
        _originalImageName = teaser.ImageFileName;
        _tagsText = string.Join(", ", teaser.Tags);
        _form = new BrainTeaser
        {
            Id = teaser.Id,
            Date = teaser.Date,
            Difficulty = teaser.Difficulty,
            Tags = new List<string>(teaser.Tags),
            ImageFileName = teaser.ImageFileName,
            ImageAlt = teaser.ImageAlt,
            Question = teaser.Question,
            Answer = teaser.Answer,
            NotAccepted = teaser.NotAccepted,
            Hint = teaser.Hint,
            Solution = teaser.Solution,
            SuggestedBy = teaser.SuggestedBy,
        };
        _savedMessage = null;
        _dateWarning = null;
        _imageError = null;
        _imageNote = null;
    }

    private Task SaveAsync()
    {
        var existing = Store.GetForDate(_form.Date);
        if (existing is not null && existing.Id != _form.Id)
        {
            _dateWarning = $"There is already a teaser on {_form.Date:d MMM yyyy}. Pick another date or edit that one below.";
            return Task.CompletedTask;
        }

        // The button is disabled without one, but only in the browser.
        if (PictureNeedsDescription)
        {
            return Task.CompletedTask;
        }

        _form.Tags = ParsedTags;
        _form.NotAccepted = string.IsNullOrWhiteSpace(_form.NotAccepted) ? null : _form.NotAccepted.Trim();
        _form.SuggestedBy = CreditName.Clean(_form.SuggestedBy);
        _form.ImageAlt = string.IsNullOrWhiteSpace(_form.ImageFileName)
            ? null
            : TextLimit.Clip(_form.ImageAlt, MaxImageAltLength);
        Store.Save(_form);

        // Original image was replaced or removed during this edit → clean it up.
        if (_originalImageName is not null && _originalImageName != _form.ImageFileName)
        {
            Images.Delete(_originalImageName);
        }

        _savedMessage = $"Saved! \"{Truncate(_form.Question, 50)}\" will show on {_form.Date:dddd d MMMM yyyy}.";
        ResetForm(discardStaged: false);   // the image just saved is now committed
        Refresh();
        return Task.CompletedTask;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (!ImageStore.IsAllowedType(file.ContentType))
        {
            _imageError = "Please choose a PNG, JPG, GIF, or WebP image.";
            return;
        }
        if (file.Size > ImageStore.MaxBytes)
        {
            _imageError = "Image must be under 3 MB.";
            return;
        }
        _imageError = null;
        DiscardStagedImage();   // replacing a previous un-saved upload
        _form.ImageFileName = await Images.SaveAsync(file);
        _imageNote = file.Size > SuggestedMaxImageBytes
            ? $"This picture is {file.Size / 1024:N0} KB, so it will load slowly on a phone. Aim for under {SuggestedMaxImageBytes / 1024} KB."
            : null;
    }

    private void RemoveImage()
    {
        DiscardStagedImage();
        _form.ImageFileName = null;
        _form.ImageAlt = null;
        _imageError = null;
        _imageNote = null;
    }

    /// <summary>Deletes a just-uploaded image that hasn't been committed to a saved teaser.</summary>
    private void DiscardStagedImage()
    {
        if (_form.ImageFileName is not null && _form.ImageFileName != _originalImageName)
        {
            Images.Delete(_form.ImageFileName);
        }
    }

    private string StatsSummary(Guid teaserId)
    {
        var stats = Stats.Get(teaserId);
        return stats.TotalSubmissions == 0
            ? "no answers yet"
            : $"{stats.SuccessfulSubmissions:N0}/{stats.TotalSubmissions:N0} successful";
    }

    private void Delete(Guid id)
    {
        var teaser = _all.FirstOrDefault(t => t.Id == id);
        Images.Delete(teaser?.ImageFileName);
        Store.Delete(id);
        Stats.Remove(id);
        if (_editingId == id)
        {
            ResetForm();
        }
        Refresh();
    }

    private void UseSuggestion(TeaserSuggestion suggestion)
    {
        // Pre-fill the add form; the suggested solution lands in Solution for
        // manual splitting into Answer/Solution before saving, and the name to credit
        // goes with it into the bank.
        DiscardStagedImage();
        _editingId = null;
        _originalImageName = null;
        _tagsText = string.Empty;
        _imageError = null;
        var date = _today;
        while (Store.GetForDate(date) is not null)
        {
            date = date.AddDays(1);
        }
        _form = new BrainTeaser
        {
            Date = date,
            Difficulty = Enum.TryParse<Difficulty>(suggestion.Difficulty, out var d) ? d : Difficulty.Medium,
            Question = suggestion.Question,
            Solution = suggestion.SolutionAndHint,
            SuggestedBy = string.IsNullOrEmpty(suggestion.AuthorName) ? null : suggestion.AuthorName,
        };
        _savedMessage = null;
        _dateWarning = null;
    }

    private void DeleteSuggestion(Guid id)
    {
        Suggestions.Delete(id);
        Refresh();
    }

    private void SetIssueStatus(Guid id, string? statusName)
    {
        if (Enum.TryParse<IssueStatus>(statusName, out var status))
        {
            Issues.SetStatus(id, status);
            Refresh();
        }
    }

    private void DeleteIssue(Guid id)
    {
        Issues.Delete(id);
        Refresh();
    }

    /// <summary>Jump straight from a report to editing the teaser it's about.</summary>
    private void EditById(Guid teaserId)
    {
        var teaser = _all.FirstOrDefault(t => t.Id == teaserId);
        if (teaser is not null)
        {
            Edit(teaser);
        }
    }

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max] + "…";
}
