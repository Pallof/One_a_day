@* Replaces the old All Questions archive. The route "/questions" is kept so old
   links and bookmarks land here rather than on a 404. *@
@page "/twentyfour"
@page "/questions"
@using System.Globalization
@inject IJSRuntime JS
@inject MetricsCounter Metrics
@inject CurrentTeaserContext OnScreen
@inject TwentyFourBoard Board
@inject ITwentyFourPlayerStorage PlayerIds
@implements IAsyncDisposable

<PageTitle>Stumpty · 24</PageTitle>

@{
    // Read by the cards and the keypad alike, so the two can never disagree.
    var used = UsedCards();
    var over = RoundOver;
}

<div class="tf-page">
    <div class="oad-banner">Twenty Four</div>

    <div class="oad-box">
        <p class="tf-lead">
            Make <strong>24</strong> from all four numbers, using only
            <strong>+ &minus; &times; &divide;</strong> and parentheses.
        </p>
        <p class="tf-rules">
            Each number must be used exactly once. Numbers run 1–10, like a deck of cards
            with the face cards counting as 10, so duplicates happen.
        </p>
        @* Players took every hand to be possible and got frustrated (feedback, 2026-10-07).
           A fact about the deck, never about the hand on the table, so it gives nothing
           away. Never say which hands or how many, or point at how the hard ones go (PRD 07). *@
        <p class="tf-rules tf-impossible">
            <strong>Not every hand can make 24.</strong> If you think yours can't, press Impossible.
        </p>
        <p class="tf-rules tf-impossible">
            Each hand you solve, or rightly call impossible, adds one to your run. Pass deals a
            fresh hand but ends your run, and so does calling a hand impossible when it can be done.
        </p>
        @* An easy base case, deliberately. Players work up from here.

           Two rules before changing this, both from PRD 07 and both learned the hard
           way — the original example used 3 3 8 8 and its only solution:
             1. Keep it an easy base case. That hand needs a fraction most players
                never find unaided, so it revealed the method outright.
             2. Never use a hand that exists in teasers.json. 3 3 8 8 is a Hard teaser
                dated 2026-07-27, so the example was publishing the answer to a real
                Challenge of the day from a different page, permanently.
           6 6 6 6 breaks neither. Don't "improve" it into something clever. *@
        <p class="tf-rules tf-example">
            For example, dealt <strong>6 6 6 6</strong> your answer could be
            <span class="tf-eg">6 + 6 + 6 + 6</span>.
        </p>
    </div>

    <div class="oad-box tf-hand-box">
        <div class="tf-hand">
            @for (var i = 0; i < _hand.Length; i++)
            {
                @* Corner ranks and suits are decorative repeats of the pip — hidden from
                   screen readers so a card announces "3", not "3 spade 3 3 spade". *@
                <span class="tf-card @SuitColour(i) @(used[i] ? "tf-card-used" : "")">
                    <span class="tf-rank" aria-hidden="true">@_hand[i]<span class="tf-suit">@Suit(i)</span></span>
                    <span class="tf-pip">@_hand[i]</span>
                    <span class="tf-rank tf-rank-br" aria-hidden="true">@_hand[i]<span class="tf-suit">@Suit(i)</span></span>
                </span>
            }
        </div>
        <p class="tf-run">Current run: <strong>@_run</strong></p>
    </div>

    <div class="oad-box">
        @* type="text" is what app.css styles every text box by; without it this one was a bare
           browser box. The heading doubles as its label for screen readers. *@
        <h2 id="tf-answer-label">Your answer:</h2>
        <input type="text" class="tf-input" aria-labelledby="tf-answer-label" placeholder="Type your answer"
               maxlength="120"
               @bind="_expression" @bind:event="oninput"
               @onkeydown="OnKeyDown"
               disabled="@over" />

        @* The dealt numbers and the symbols as buttons, so a phone player never swaps between
           the letter and number keyboards. Touch screens only — the stylesheet hides it where
           there's a mouse, and so a keyboard. Tapping never focuses the box, which would
           bring the phone's keyboard up over the keypad (PRD 07). *@
        <div class="tf-keypad" role="group" aria-label="Number and symbol buttons">
            @for (var i = 0; i < _hand.Length; i++)
            {
                var number = _hand[i];
                @* Goes out with its card, and comes back with it. *@
                <button class="tf-key tf-key-number" disabled="@(over || used[i])"
                        @onclick="() => Tap(number.ToString(CultureInfo.InvariantCulture))">@number</button>
            }
            @foreach (var key in SymbolKeys)
            {
                <button class="tf-key tf-key-symbol" aria-label="@key.Name" disabled="@over"
                        @onclick="() => Tap(key.Text)">@key.Text</button>
            }
            <button class="tf-key tf-key-delete" aria-label="Delete"
                    disabled="@(over || string.IsNullOrWhiteSpace(_expression))"
                    @onclick="DeleteLast">⌫</button>
        </div>

        <div class="tf-buttons">
            <button class="oad-btn-green" @onclick="Submit"
                    disabled="@(over || string.IsNullOrWhiteSpace(_expression))">
                Submit
            </button>
            <button class="tf-call" @onclick="CallImpossible" disabled="@over">
                Impossible
            </button>
            <button class="tf-pass" @onclick="Pass" disabled="@over">
                Pass
            </button>
        </div>

        @if (_message is not null)
        {
            <p class="tf-message @(_state switch {
                    RoundState.Solved or RoundState.CalledRight => "tf-correct",
                    RoundState.Passed => "tf-passed",
                    _ => "tf-wrong" })">@_message</p>
        }

    </div>

    @if (over)
    {
        <div class="oad-box tf-next-box">
            <button class="tf-next" @onclick="() => NewHand()">Deal a new hand</button>
            @* Hidden on touch screens, which have no space bar. *@
            <p class="tf-next-hint">or press the space bar</p>
        </div>
    }

    <section class="oad-box tf-board" aria-labelledby="tf-board-title">
        <h2 id="tf-board-title">Longest runs</h2>
        @if (_player is { } me)
        {
            <p class="tf-board-note">You play as <strong>@me.Name</strong>.</p>
        }
        else if (_browserAnswered && !_triedJoining)
        {
            <p class="tf-board-note">Get a hand right and you'll get a name on the board.</p>
        }
        <div class="tf-board-lists">
            @foreach (var (title, runs, empty) in new[]
            {
                ("Today", Board.Today, "No runs yet today. Solve a hand to get on the board."),
                ("All time", Board.AllTime, "No runs yet."),
            })
            {
                <div class="tf-board-list">
                    <h3>@title</h3>
                    @if (runs.Count == 0)
                    {
                        <p class="tf-board-empty">@empty</p>
                    }
                    else
                    {
                        <ol>
                            @for (var place = 0; place < runs.Count; place++)
                            {
                                var row = runs[place];
                                var mine = row.Player.Id == _player?.Id;
                                <li class="tf-row @(mine ? "tf-row-you" : "")">
                                    <span class="tf-place">@(place + 1)</span>
                                    <span class="tf-name">@row.Player.Name@(mine ? " (you)" : "")</span>
                                    <span class="tf-length">@row.Run</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    /// <summary>
    /// Where the hand on the table stands. A solve and either Impossible call end the round:
    /// the hand stays on screen, locked, until "Deal a new hand". Pass deals straight away.
    /// </summary>
    private enum RoundState { Playing, Wrong, Solved, Passed, CalledRight, CalledWrong }

    private readonly Random _random = new();
    private int[] _hand = [];
    private string _expression = string.Empty;
    private string? _message;
    private RoundState _state = RoundState.Playing;
    private DotNetObjectReference<TwentyFour>? _selfRef;

    /// <summary>
    /// Hands in a row solved or rightly called impossible (PRD 07). Kept for this visit only:
    /// leaving the page ends a run, as Pass does, so a reload can't escape a hard hand.
    /// </summary>
    private int _run;

    /// <summary>
    /// Who's playing: once the browser has said, or once a new player has got a hand right. Until
    /// then a run counts but isn't on the board.
    /// </summary>
    private TwentyFourPlayer? _player;

    /// <summary>The browser has said whether it has a player. Until it has, no new one is made, or it could replace one it has.</summary>
    private bool _browserAnswered;

    /// <summary>A new player was asked for this visit. Once, whether or not the browser kept it.</summary>
    private bool _triedJoining;

    private bool RoundOver => _state is RoundState.Solved or RoundState.CalledRight or RoundState.CalledWrong;

    protected override void OnInitialized() => NewHand();

    /// <summary>
    /// Which dealt cards the current expression has spent.
    /// </summary>
    /// <remarks>
    /// Recomputed on every render, and the expression box binds on <c>oninput</c>, so
    /// this follows deleting exactly as it follows typing — erase a number and its
    /// card lights straight back up. There is no separate "used" state to fall out of
    /// sync, because there is no stored state at all: it is derived from the text.
    ///
    /// Parsing goes through <see cref="Arithmetic.Operands"/>, the same parser
    /// <see cref="TwentyFourGame.Check"/> validates with, so what the cards show can
    /// never disagree with what the game accepts.
    /// </remarks>
    private bool[] UsedCards()
    {
        var flags = new bool[_hand.Length];

        // On a solve every card is spent — dimming the whole hand under the confetti
        // would read as a loss. Show the winning hand lit, and a called one too.
        if (RoundOver || string.IsNullOrWhiteSpace(_expression))
        {
            return flags;
        }

        var remaining = new Dictionary<decimal, int>();
        foreach (var operand in Arithmetic.Operands(_expression))
        {
            remaining[operand] = remaining.GetValueOrDefault(operand) + 1;
        }

        // Spend duplicates left to right: with a pair of 3s, typing one 3 dims the
        // first card only, so the player can still see they have another in hand.
        for (var i = 0; i < _hand.Length; i++)
        {
            var value = (decimal)_hand[i];
            if (remaining.GetValueOrDefault(value) > 0)
            {
                remaining[value]--;
                flags[i] = true;
            }
        }
        return flags;
    }

    /// <summary>
    /// Suit for the card in this position. Purely cosmetic — the game has no suits and
    /// nothing reads them — but giving duplicates different suits makes them tellable
    /// apart, which starts to matter once one of a pair dims and the other doesn't.
    /// </summary>
    private static string Suit(int index) => index switch
    {
        0 => "♠",
        1 => "♥",
        2 => "♣",
        _ => "♦",
    };

    private static string SuitColour(int index) => index is 1 or 3 ? "tf-card-red" : "tf-card-black";

    private sealed record SymbolKey(string Text, string Name);

    /// <summary>
    /// The keypad's symbols, as the rules print them. The answer check reads − × ÷ the same
    /// as - * /, so a tapped answer and a typed one are judged alike.
    /// </summary>
    private static readonly SymbolKey[] SymbolKeys =
    [
        new("+", "plus"),
        new("−", "minus"),
        new("×", "times"),
        new("÷", "divided by"),
        new("(", "open bracket"),
        new(")", "close bracket"),
    ];

    /// <summary>
    /// A keypad tap: adds that number or symbol to the end of the answer, spaced as it would
    /// be written — <c>(10 − 4) × 2</c>. Two numbers tapped in a row stay apart, "3 8", so
    /// the check calls it a missing symbol, not a number the player never meant.
    /// </summary>
    private void Tap(string key)
    {
        if (RoundOver)
        {
            return;   // disabled in the browser; see Submit
        }

        var text = _expression.TrimEnd();
        var next = text.Length == 0 || text.EndsWith('(') || key == ")"
            ? text + key
            : $"{text} {key}";
        if (next.Length <= TwentyFourGame.MaxExpressionLength)
        {
            _expression = next;
        }
    }

    /// <summary>
    /// The keypad's ⌫: takes back the last number or symbol, so one press undoes one tap —
    /// a 10 goes in one press, as it came in one.
    /// </summary>
    private void DeleteLast()
    {
        if (RoundOver)
        {
            return;
        }

        var text = _expression.TrimEnd();
        if (text.Length == 0)
        {
            return;
        }

        var cut = text.Length - 1;
        while (cut > 0 && char.IsDigit(text[cut]) && char.IsDigit(text[cut - 1]))
        {
            cut--;
        }
        _expression = text[..cut].TrimEnd();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("oadTwentyFour.register", _selfRef);
            await LoadPlayerAsync();
            StateHasChanged();
        }
    }

    /// <summary>
    /// The player this browser plays as, if it has one. A browser that can't be read stays off
    /// the board this visit; one that has none gets a player at its first hand right.
    /// </summary>
    private async Task LoadPlayerAsync()
    {
        try
        {
            if (await PlayerIds.ReadAsync() is { Number: > 0 } stored && stored.Id != Guid.Empty)
            {
                _player = stored;
            }
            _browserAnswered = true;
        }
        catch (Exception e) when (e is JSDisconnectedException or TaskCanceledException or InvalidOperationException
                                      or JSException)
        {
            // The browser went away, or won't store anything. The game plays on regardless.
        }

        // Hands solved while the browser was still answering.
        if (_player is null && _run > 0)
        {
            await JoinAsync();
        }
        if (_player is { } player && _run > 0)
        {
            Board.Record(player, _run);
        }
    }

    /// <summary>Space bar shortcut for "Deal a new hand" — only once a round is over.</summary>
    [JSInvokable]
    public Task DealFromSpaceBar()
    {
        if (!RoundOver)
        {
            return Task.CompletedTask;
        }
        return InvokeAsync(() =>
        {
            NewHand();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Deals the next hand. With a note it's Pass, which may replace a hand in play; without one
    /// it's "Deal a new hand", by button or space bar, which may only once the round is over.
    /// </summary>
    private void NewHand(string? note = null)
    {
        // Blazor keeps a removed button's click alive until the browser confirms the redraw, so
        // a quick double tap on "Deal a new hand", or a client sending the click again, arrives
        // with the next hand already in play. Dealing again would be a free Pass that keeps the
        // run (found in review, 2026-10-29).
        if (note is null && _hand.Length > 0 && !RoundOver)
        {
            return;
        }

        _hand = TwentyFourGame.Deal(_random);
        // Let "Report an issue" name the hand on screen — this one, not the first dealt.
        OnScreen.SetHand(_hand);
        _expression = string.Empty;
        _message = note;
        _state = note is null ? RoundState.Playing : RoundState.Passed;
    }

    /// <summary>
    /// Makes this browser a player, with the next number, the first time it gets a hand right.
    /// Only once the browser has said it has none, and only once a visit. Only a player the
    /// browser keeps goes on the board: one it won't save would put each visit on under a new
    /// name (PRD 07).
    /// </summary>
    private async Task JoinAsync()
    {
        if (!_browserAnswered || _triedJoining)
        {
            return;
        }
        _triedJoining = true;
        if (Board.NewPlayer() is not { } player)
        {
            return;   // the number couldn't be saved; the board logs it
        }
        try
        {
            await PlayerIds.WriteAsync(player);
            _player = player;
        }
        catch (Exception e) when (e is JSDisconnectedException or TaskCanceledException or InvalidOperationException
                                      or JSException)
        {
            // The browser won't keep it. Its number goes unused.
        }
    }

    /// <summary>One more hand in a row, onto the board if it earns a place.</summary>
    private async Task<string> ExtendRunAsync()
    {
        _run++;
        if (_player is null)
        {
            await JoinAsync();
        }
        if (_player is { } player)
        {
            Board.Record(player, _run);
        }
        return _run == 1 ? "That starts a run." : $"That's {_run} in a row.";
    }

    /// <summary>The run is over. Returns how long it was, 0 when there was none.</summary>
    private int EndRun()
    {
        var ended = _run;
        _run = 0;
        return ended;
    }

    private async Task Submit()
    {
        // The buttons are disabled once a round is over, but only in the browser. A client
        // driving the live connection could otherwise keep "solving" the same hand, inflating
        // the run, the board and the site metrics (PRD 16).
        if (RoundOver)
        {
            return;
        }

        var check = TwentyFourGame.Check(_expression, _hand);
        _message = check.Message;

        // A wrong answer leaves the run alone: try again as often as you like. Only Pass and
        // a wrong Impossible call end it (author's decision, 2026-10-29).
        if (check.IsCorrect)
        {
            _state = RoundState.Solved;
            _message = $"{check.Message} {await ExtendRunAsync()}";
        }
        else
        {
            _state = RoundState.Wrong;
        }

        // Submitting is what makes a Twenty Four visitor count; opening the page isn't.
        if (!string.IsNullOrWhiteSpace(_expression))
        {
            await Metrics.TwentyFourAnswerAsync(check.IsCorrect);
        }

        if (check.IsCorrect)
        {
            await JS.InvokeVoidAsync("oadCelebrate");
        }
    }

    // Passing deals again and says nothing about the hand. Showing the solution would hand
    // over the answer to a puzzle the player is still capable of cracking, and saying whether
    // it could be done is what Impossible is for, at the risk of the run.
    private async Task Pass()
    {
        if (RoundOver)
        {
            return;   // disabled in the browser; see Submit
        }
        var ended = EndRun();
        NewHand(ended == 0
            ? "Passed. Here's a fresh hand."
            : $"Passed, ending your run of {ended}. Here's a fresh hand.");
        await Metrics.TwentyFourPassAsync();
    }

    /// <summary>
    /// The player says this hand can't make 24. Right, it counts like a solve; wrong, the run
    /// ends. Either way the round is over, and the page says only whether the hand could be
    /// done, never how (author's decision, 2026-10-29).
    /// </summary>
    private async Task CallImpossible()
    {
        if (RoundOver)
        {
            return;   // disabled in the browser; see Submit
        }

        var right = !TwentyFourGame.HasSolution(_hand);
        if (right)
        {
            _state = RoundState.CalledRight;
            _message = $"Right, these four can't make 24. {await ExtendRunAsync()}";
        }
        else
        {
            _state = RoundState.CalledWrong;
            var ended = EndRun();
            _message = ended == 0 ? "It could be done." : $"It could be done. Your run of {ended} ends here.";
        }

        await Metrics.TwentyFourImpossibleAsync(right);

        if (right)
        {
            await JS.InvokeVoidAsync("oadCelebrate");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Any hand still in play, a passed one included: until 2026-10-29 Enter did nothing on
        // the hand Pass dealt until Submit was clicked once.
        if (e.Key == "Enter" && !RoundOver && !string.IsNullOrWhiteSpace(_expression))
        {
            await Submit();
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Leaving the game: stop naming its hand in reports. First, ahead of the early return
        // below — the hand is set for every copy of the page.
        OnScreen.ClearHand(_hand);

        // Only the live copy of this page registered with the script. The server first
        // renders the page as plain HTML, and that copy never reaches OnAfterRenderAsync —
        // calling the script from it throws, because there's no live connection yet. That
        // logged an unhandled exception on every direct visit to /twentyfour.
        if (_selfRef is null)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("oadTwentyFour.unregister");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; nothing left to unhook.
        }
        _selfRef?.Dispose();
    }
}
