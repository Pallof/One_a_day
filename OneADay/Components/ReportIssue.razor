@inject IssueStore Issues
@inject EmailNotifier Notifier
@inject CurrentTeaserContext TeaserContext
@inject NavigationManager Nav
@implements IDisposable

@* The layout carries this dialog on every page and opens it from its menu; it also says
   where the floating button shows (PRD 06). *@
@if (FloatingButton is not FloatingButtonShown.Never)
{
    <button class="ri-fab @(FloatingButton is FloatingButtonShown.WideScreensOnly ? "ri-fab-wide-only" : "")"
            title="Report an issue" @onclick="Open">
        <span class="ri-fab-icon">⚠️</span>
        <span class="ri-fab-label">Report an issue</span>
    </button>
}

@if (_open)
{
    <div class="ri-backdrop" @onclick="Close"></div>

    @* Focus moves here on opening. Opened from the menu, that also closes the menu, which
       stays open for as long as it holds the focus. *@
    <div class="ri-modal" role="dialog" aria-modal="true" aria-labelledby="ri-title"
         tabindex="-1" @ref="_dialog">
        <div class="ri-head">
            <h2 id="ri-title">Report an issue</h2>
            <button class="ri-close" title="Close" @onclick="Close">✕</button>
        </div>

        @if (_submitted && _inboxFull)
        {
            <p class="ri-thanks">Our report inbox is full right now, so this report couldn't be saved. Please try again later.</p>
            <div class="ri-actions">
                <button class="oad-btn-green" @onclick="Close">Done</button>
            </div>
        }
        else if (_submitted)
        {
            <p class="ri-thanks">✅ Thanks for letting us know — we'll take a look!</p>
            <div class="ri-actions">
                <button class="oad-btn-green" @onclick="Close">Done</button>
            </div>
        }
        else
        {
            @if (_teaserQuestion is not null)
            {
                <p class="ri-context">About: <em>@Truncate(_teaserQuestion, 90)</em></p>
            }
            else if (_hand is not null)
            {
                <p class="ri-context">About: the Twenty Four hand <strong>@HandText(_hand)</strong></p>
            }

            @* A list to tap, not a dropdown. A closed dropdown can't wrap, and the longest
               category is wider than any phone, so it showed cut off mid-word. A list also
               shows all three at once — one tap, not two. *@
            <fieldset class="ri-categories">
                <legend>What was the issue?</legend>
                @for (var i = 0; i < IssueCategories.All.Length; i++)
                {
                    var category = IssueCategories.All[i];
                    <label class="ri-choice">
                        <input type="radio" id="ri-category-@i" name="ri-category" value="@category"
                               checked="@(_category == category)" @onchange="() => _category = category" />
                        <span>@category</span>
                    </label>
                }
            </fieldset>

            <div class="ri-field">
                <label for="ri-details">Describe the issue *</label>
                <textarea id="ri-details" rows="5" maxlength="@IssueReport.MaxDetailsLength"
                          placeholder="Tell us what happened — e.g. what you typed, what you expected, or what looked wrong."
                          @bind="_details" @bind:event="oninput"></textarea>
                <span class="ri-counter">@_details.Length / @IssueReport.MaxDetailsLength</span>
            </div>

            @* Decoy field — see Contact.razor for the full reasoning. Hidden from
               sight, tab order, and screen readers; only a script fills it. *@
            <input class="ri-hp" id="ri-website" name="website" type="text"
                   tabindex="-1" autocomplete="off" aria-hidden="true"
                   @bind="_honeypot" @bind:event="oninput" />

            <div class="ri-actions">
                <button class="oad-btn-green" @onclick="Submit"
                        disabled="@string.IsNullOrWhiteSpace(_details)">
                    Send report
                </button>
                <button class="ri-cancel" @onclick="Close">Cancel</button>
            </div>
        }
    </div>
}

@code {
    /// <summary>Where the floating button, bottom right, shows.</summary>
    public enum FloatingButtonShown
    {
        /// <summary>At every width.</summary>
        Always,

        /// <summary>
        /// Only where the menu is a row of sections, with no room for the report entry. The
        /// stylesheet's breakpoint is the layout's: they must move together.
        /// </summary>
        WideScreensOnly,

        Never,
    }

    [Parameter] public FloatingButtonShown FloatingButton { get; set; } = FloatingButtonShown.Always;

    private bool _open;
    private bool _submitted;
    private ElementReference _dialog;
    private bool _focusDialog;

    /// <summary>The report couldn't be saved: <see cref="IssueStore.MaxOpenReports"/> are open.</summary>
    private bool _inboxFull;

    private string _category = IssueCategories.Wording;
    private string _details = string.Empty;
    private Guid? _teaserId;
    private string? _teaserQuestion;

    /// <summary>The Twenty Four hand on screen when the dialog opened, if any.</summary>
    private int[]? _hand;

    /// <summary>Decoy field — see the markup. Anything here means a script filled it.</summary>
    private string _honeypot = string.Empty;

    /// <summary>
    /// When the dialog opened — the moment this form became available, which is the
    /// right clock for a modal. Anchoring to page load instead would punish someone
    /// who reads a puzzle for ten minutes and only then reports a problem with it.
    /// </summary>
    private DateTime _dialogShownAt;

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    /// <summary>
    /// Opens the dialog — from the floating button, or from the layout's menu. The menu's
    /// click belongs to the layout, which doesn't re-render this component on its own, hence
    /// the explicit render.
    /// </summary>
    public void Open()
    {
        // Snapshot the puzzle being viewed, so the report is actionable — a copy of the hand,
        // since Pass deals the page a new one.
        var teaser = TeaserContext.Current;
        _teaserId = teaser?.Id;
        _teaserQuestion = teaser?.Question;
        _hand = TeaserContext.Hand?.ToArray();

        _category = IssueCategories.Wording;
        _details = string.Empty;
        _honeypot = string.Empty;
        _dialogShownAt = DateTime.UtcNow;
        _submitted = false;
        _inboxFull = false;
        _open = true;
        _focusDialog = true;
        StateHasChanged();
    }

    private void Close() => _open = false;

    /// <summary>
    /// The dialog belongs to the page it was opened on — its question, its address. It lives
    /// in the layout now, so leaving the page (the phone's back swipe, say) would otherwise
    /// carry it, open, onto the next one.
    /// </summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open)
        {
            _open = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog && _open)
        {
            _focusDialog = false;
            await _dialog.FocusAsync();
        }
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_details))
        {
            return;
        }

        // Looks scripted? Show the normal confirmation and drop it silently, the same
        // way the suggestion form does. Note this caps *automation*, not volume — a
        // person may still file as many reports as they hit problems.
        if (SubmissionGuard.LooksAutomated(_honeypot, DateTime.UtcNow - _dialogShownAt))
        {
            Issues.RecordBlocked();
            _submitted = true;
            return;
        }

        // Every field a client can set is held to what the dialog allows: the dialog's three
        // categories, the textarea's length, and a page address of sensible size. A client
        // driving the live connection can send far more, and it would all be stored.
        var report = new IssueReport
        {
            SubmittedAt = AppTime.NowPacific,
            Category = IssueCategories.Normalise(_category),
            Details = TextLimit.Clip(_details, IssueReport.MaxDetailsLength),
            PageUrl = TextLimit.Clip(
                Nav.ToBaseRelativePath(Nav.Uri) is var path && path.Length > 0 ? "/" + path : "/",
                IssueReport.MaxPageUrlLength),
            TeaserId = _teaserId,
            TeaserQuestion = _teaserQuestion,
            TwentyFourHand = _hand,
        };

        _submitted = true;
        if (!Issues.Add(report))
        {
            // The inbox is at its ceiling. Say so: a report that silently vanishes is a broken
            // question nobody hears about, and this sender may be real.
            _inboxFull = true;
            return;
        }

        // Saved first, notified second — same contract as the suggestion form.
        // Reports are uncapped by design (PRD 06), so the notifier's own daily cap is
        // what stops a burst of them burying the inbox. Hitting that cap skips the
        // mail, never the save.
        Notifier.Enqueue(
            $"Stumpty — issue reported ({ShortCategory(report.Category)})",
            $"""
             A visitor reported a problem.

             Category  : {report.Category}
             Page      : {report.PageUrl}
             Submitted : {report.SubmittedAt:dddd d MMMM yyyy, h:mm tt} Pacific
             {OnScreen(report)}

             WHAT THEY SAID
             {report.Details}

             Triage it in admin — New / In progress / Solved / Won't solve / Duplicate.
             """);
    }

    /// <summary>
    /// A short tag for the subject line. The three categories are long sentences, and
    /// a subject that starts with 40 identical characters is unscannable in an inbox.
    /// </summary>
    private static string ShortCategory(string category) => category switch
    {
        IssueCategories.Wording => "wording",
        IssueCategories.Evaluation => "answer not accepted",
        _ => "other",
    };

    /// <summary>The email's line for what was on screen: a question, a hand, or neither.</summary>
    private static string OnScreen(IssueReport report) =>
        report.TeaserQuestion is { } question ? $"Teaser    : {question}"
        : report.TwentyFourHand is { } hand ? $"24 hand   : {HandText(hand)}"
        : "Teaser    : (not a challenge page)";

    private static string HandText(IEnumerable<int> hand) => string.Join(" ", hand);

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max] + "…";
}
