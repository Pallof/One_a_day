@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<a class="oad-skip" href="#oad-main">Skip to content</a>

@* Full-bleed band. The bar spans the whole viewport; only .oad-header-inner is
   capped and centred, so the rule under the header reaches both edges on a wide
   monitor instead of stopping short. *@
<header class="oad-header">
    <div class="oad-header-inner">
        @* The brand doubles as the way home — one click back to today's
           challenge from anywhere, without opening the menu. *@
        <a class="oad-wordmark" href="" title="Back to the Challenge of the day">
            <span class="oad-mark" aria-hidden="true">🧠</span>
            <span>Stumpty</span>
        </a>

        @* Wide screens get the sections inline; the hamburger is for narrow ones. *@
        <nav class="oad-nav" aria-label="Main">
            @foreach (var item in NavItems)
            {
                <a href="@item.Href" class="oad-nav-link @(IsCurrent(item.Href) ? "oad-nav-current" : "")"
                   aria-current="@(IsCurrent(item.Href) ? "page" : null)">@item.Label</a>
            }
        </nav>

        <div class="oad-menu-wrap">
            <button class="oad-menu-button" title="Menu" aria-label="Menu">
                <span></span><span></span><span></span>
            </button>
            <nav class="oad-menu-panel" aria-label="Main menu">
                <ul>
                    @foreach (var item in NavItems)
                    {
                        <li><a href="@item.Href" aria-current="@(IsCurrent(item.Href) ? "page" : null)">@item.Label</a></li>
                    }
                    @* No admin link, in any mode. This menu is the visitor's map of the site
                       and /admin isn't part of it; a link that appears only sometimes is one
                       more thing to get wrong. The author reaches it by bookmark, on the one
                       machine where the page exists at all (PRD 10). *@
                </ul>
            </nav>
        </div>
    </div>
</header>

@* The single place the reading column is capped and centred. Admin opts into the
   wider measure because its tables don't fit a reading column — but the centring
   still happens here, not in the page. *@
<main id="oad-main" class="oad-main oad-measure @(IsWidePage ? "oad-measure-wide" : "")">
    @Body
</main>

<footer class="oad-footer">
    <div class="oad-measure">
        @* One line, not two: a second footer row pushed the home page past the 860px
           no-scrollbar target (PRD 09). Wraps naturally on narrow screens. A div, not a
           p — the sign-up dialog renders block elements, which a p can't contain. *@
        <div class="oad-footer-line">
            <span>Stumpty 🧠 — one puzzle a day to sharpen how you think.</span>
            @* Home page only: the offer is "this challenge, every morning", which only
               makes sense sitting under the challenge. Elsewhere it's clutter. *@
            @if (IsHomePage)
            {
                <span class="oad-footer-sep" aria-hidden="true">·</span>
                <SubscribeDialog />
            }
        </div>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private sealed record NavItem(string Href, string Label);

    private static readonly NavItem[] NavItems =
    [
        new("", "Today"),
        new("yesterday", "Yesterday's solution"),
        new("twentyfour", "24"),
        new("about", "About"),
        new("contact", "Suggest a teaser"),
    ];

    /// <summary>Dense pages that need more than a reading column.</summary>
    private bool IsWidePage =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("admin", StringComparison.OrdinalIgnoreCase);

    /// <summary>Today's challenge — the only page that offers the email sign-up.</summary>
    private bool IsHomePage => IsCurrent("");

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    /// <summary>Marks the active section, so the current page is obvious in the bar.</summary>
    private bool IsCurrent(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        return href.Length == 0 ? path.Length == 0 : path.Equals(href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
