node_modules/
.DS_Store

# .NET build output
bin/
obj/
*.user

# Claude Code local settings
.claude/settings.local.json

# Claude Code agents' temporary working copies. Each holds its own .git link, so
# `git add .` would stage it as an embedded repository.
.claude/worktrees/

# App data — never commit. Contains the question bank (questions, answers,
# hints, solutions) plus visitor-submitted content. Back it up separately.
OneADay/App_Data/

# Authoring source for the question bank — same reason as App_Data: it holds
# questions with their hints and solutions. Nothing in the app reads it; it is
# the hand-written draft the bank is imported from. Back it up separately.
OneADay/BrainTeaserQuestions.txt
